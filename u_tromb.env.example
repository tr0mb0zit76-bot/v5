# Шаблон для файла `.env.testing` (в корне проекта, в .gitignore).
# Laravel подхватывает его при APP_ENV=testing (в т.ч. при `php artisan test`).
#
# Зачем отдельная БД (например u_tromb): миграции и тесты не должны стирать вашу
# рабочую локальную базу из обычного `.env`.
#
# Как использовать:
#   1. Создайте пустую схему MySQL `u_tromb` (или своё имя — поправьте DB_DATABASE ниже).
#   2. Скопируйте этот файл:  copy u_tromb.env.example .env.testing   (Windows / macOS / Linux по-разному)
#   3. Выполните: php artisan key:generate --show   и подставьте APP_KEY, либо сгенерируйте в .env.testing отдельно.
#   4. php artisan migrate --env=testing
#   5. Опционально фикстуры: php artisan db:seed --class=TeachingDatabaseSeeder --env=testing

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u_tromb
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=null
CACHE_STORE=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array

DOCUMENT_STORAGE=local
